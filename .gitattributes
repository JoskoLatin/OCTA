# Normalize line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Text formats — force LF so diffs stay stable cross-platform.
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.svg     text eol=lf
*.md      text eol=lf
*.xml     text eol=lf
*.gradle  text eol=lf
*.pro     text eol=lf
*.java    text eol=lf
*.properties text eol=lf

# Shell scripts must be LF or they break; Windows batch must be CRLF.
*.sh      text eol=lf
gradlew   text eol=lf
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binaries — never touch.
*.png     binary
*.apk     binary
*.jar     binary
*.keystore binary
*.woff2   binary
